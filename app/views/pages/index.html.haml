.splash-content
  .row
    .col-xs-12.col-sm-8.col-sm-offset-2
      .splash-text-container.centered-text
        %h3.headroom
          Seen bed bugs somewhere?
        %h1.centered-text
          Check Before You Stay

  .row.more-headroom
    .col-xs-12.col-sm-8.col-sm-offset-2
      = render partial: "layouts/search", locals: {splash: true}

  .row.more-headroom.splash-bottom-padding
    .col-xs-12.col-sm-6.col-sm-offset-3
      = button_to new_bed_bug_report_path, method: :get, class: "btn btn-lg btn-purple splash-add-restroom-btn" do
        Report Bed Bugs
        %i.fa.fa-plus-square-o.fa-2x
  = render 'layouts/footer'

.row.headroom
  .col-xs-12
    .listItem.showPageItem{"data-id" => @bed_bug_report.id}
      = render partial: 'bed_bug_reports/bed_bug_report', locals: { bed_bug_report: @bed_bug_report }

.showPageContent
  .row
    .col-xs-12
      .btn-group{role: "group"}
        = link_to bed_bug_report_path(bed_bug_report: { upvote: true }),
                    method: 'put' do
          %button.btn.btn-lg.btn-success
            %i.fa.fa-thumbs-up
            = t('.thumbs-up-button-label')

        = link_to bed_bug_report_path(bed_bug_report: { downvote: true }),
                    method: 'put' do
          %button.btn.btn-lg.btn-danger
            %i.fa.fa-thumbs-down
            = t('.thumbs-down-button-label')
  .row.headroom
    .col-xs-12

      %p
        %strong #{t('bed_bug_report.directions')}:
        = @bed_bug_report.directions
      %p
        %strong #{t('bed_bug_report.comments')}:
        = @bed_bug_report.comment
      %p= link_to t('bed_bug_report.edit.editlisting'), new_bed_bug_report_path(id: @bed_bug_report.id, bed_bug_report_name: @bed_bug_report.name, edit_id: @bed_bug_report.edit_id)
  .row
    .col-xs-12
      #map
        %div#mapArea{ data: { latitude: @bed_bug_report.latitude, longitude: @bed_bug_report.longitude } }
      %hr
  .row
    .col-xs-12
      = render partial: 'layouts/disqus_tag', locals: { identifier: "bed-bug-report-#{@bed_bug_report.id}", title: @bed_bug_report.name, url: request.original_url }
